{
  "name": "scriptcraft",
  "version": "2.0.0",
  "description": "ScriptCraft - Professional text-to-handwriting converter. Transform digital text into authentic handwritten images instantly.",
  "main": "js/app.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "cypress run",
    "eslint": "eslint --fix \"js/**/**.mjs\"",
    "prettier": "prettier --write \"./index.html\" \"js/**/**.mjs\" \"css/**.css\"",
    "format": "npm run prettier",
    "cy": "cypress open",
    "dev": "serve .",
    "build": "echo 'Build completed'",
    "start": "serve . -p 3000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhmdusman/scriptcraft.git"
  },
  "keywords": [
    "handwriting",
    "text-to-image",
    "document-converter",
    "handwriting-generator",
    "pdf-generator",
    "assignment-tool",
    "note-taking"
  ],
  "author": "Muhammad Usman <muhmdusman@email.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/muhmdusman/scriptcraft/issues"
  },
  "homepage": "https://scriptcraft.app",
  "devDependencies": {
    "cypress": "^4.4.1",
    "eslint": "^7.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.2.5",
    "prettier": "^2.0.5",
    "serve": "^11.3.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run prettier && eslint . --fix && npm run eslint"
    }
  }
}
