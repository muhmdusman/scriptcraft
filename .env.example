# ScriptCraft Environment Variables
# Copy this file to .env and fill in your values

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
PLAUSIBLE_DOMAIN=scriptcraft.app

# Payment Integration (Stripe)
STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_YEARLY=price_xxxxxxxxxxxx

# Feature Flags
ENABLE_PREMIUM_FEATURES=true
ENABLE_TRIAL_MODE=true

# Support
SUPPORT_EMAIL=support@scriptcraft.app
